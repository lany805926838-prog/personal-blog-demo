---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pageSize = 10;
const currentPage = 1;
const totalPosts = posts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / pageSize));
const visiblePosts = posts.slice(0, pageSize);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);

const profileEntry = await getEntry('profile', 'about');
if (!profileEntry) {
  throw new Error('Missing profile content at src/content/profile/about.md');
}
const profile = profileEntry.data;
---

<BaseLayout title={`${profile.name} 的 AI 应用项目博客`} description={profile.bio}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">AI Application Portfolio</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.bio}</p>
      <div class="hero-actions">
        <a class="button primary" href="/posts">看项目文章</a>
        <a class="button secondary" href="/about">关于我</a>
      </div>
    </div>
    <div class="hero-media" aria-label="个人资料预览">
      <img src={profile.avatar} alt={`${profile.name}的头像`} />
      <div>
        <strong>{profile.role}</strong>
        <span>{profile.location}</span>
      </div>
    </div>
  </section>

  <section class="section split">
    <div>
      <p class="eyebrow">Focus</p>
      <h2>把日常问题做成可用的小工具</h2>
    </div>
    <p>这里主要记录我自己做过的项目：为什么想做、做了哪些功能、用了哪些工具、最后做出了什么结果。每篇文章都尽量写得简单一点，方便以后回头看。</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest Projects</p>
        <h2>最新项目文章</h2>
        <p class="section-note">首页每页展示 {pageSize} 篇，目前共 {totalPosts} 篇。</p>
      </div>
      <a class="text-link" href="/posts">全部文章</a>
    </div>
    <div class="post-grid">
      {visiblePosts.map((post) => (
        <PostCard
          href={`/posts/${post.slug}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          tags={post.data.tags}
          cover={post.data.cover}
        />
      ))}
    </div>
    {
      totalPages > 1 && (
        <nav class="pagination" aria-label="首页文章分页">
          <span>第 {currentPage} / {totalPages} 页</span>
          <div>
            {pageNumbers.map((pageNumber) => (
              <a
                class:list={['page-link', { active: pageNumber === currentPage }]}
                href={pageNumber === 1 ? '/' : `/page/${pageNumber}`}
                aria-current={pageNumber === currentPage ? 'page' : undefined}
              >
                {pageNumber}
              </a>
            ))}
            <a class="page-link next" href="/page/2">下一页</a>
          </div>
        </nav>
      )
    }
  </section>
</BaseLayout>

<style>
  .section-note {
    color: var(--muted);
    font-size: 15px;
    margin: 12px 0 0;
  }

  .pagination {
    align-items: center;
    border-top: 1px solid var(--line);
    color: var(--muted);
    display: flex;
    gap: 18px;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 20px;
  }

  .pagination > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }

  .page-link {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--accent-strong);
    display: inline-flex;
    font-weight: 740;
    min-height: 38px;
    min-width: 38px;
    padding: 8px 12px;
  }

  .page-link.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .page-link:hover {
    border-color: var(--accent);
  }

  @media (max-width: 620px) {
    .pagination {
      align-items: flex-start;
      flex-direction: column;
    }

    .pagination > div {
      justify-content: flex-start;
    }
  }
</style>
